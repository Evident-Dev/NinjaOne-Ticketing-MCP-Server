# Railway will supply PORT automatically. Only set this for local development.
PORT=3000

# Your NinjaOne instance URLs.
# Token URL format:  https://<your-instance>.rmmservices.net/oauth/token
# API base URL format: https://<your-instance>.rmmservices.net/api/v2
NINJA_TOKEN_URL=https://your-instance.rmmservices.net/oauth/token
NINJA_API_BASE_URL=https://your-instance.rmmservices.net/api/v2

# OAuth2 client credentials — create these in NinjaOne under Administration > Apps > API.
# Keep these secret. Set them as Railway environment variables, never commit them.
NINJA_CLIENT_ID=replace_me
NINJA_CLIENT_SECRET=replace_me

# Protects the /mcp endpoint. Pick a long random string (e.g. openssl rand -hex 32).
# Clients must send: Authorization: Bearer <this value>
# Leave blank to disable auth (local dev only — always set this in production).
MCP_SHARED_SECRET=replace_me_with_a_long_random_string

# Optional: pre-select a default ticket form and board so you don't have to pass
# them on every create call. Leave blank to require them per-request.
# Use ninja_list_ticket_forms and ninja_list_ticket_boards to find valid IDs.
DEFAULT_TICKET_FORM_ID=
DEFAULT_BOARD_ID=

# Your NinjaOne technician email address (the account you log in with).
# When set: tickets you create are auto-assigned to you, and your name is
# appended to comments so they're attributable (the API otherwise shows the
# app name). Each person deploying their own instance sets their own email here.
TECHNICIAN_EMAIL=
