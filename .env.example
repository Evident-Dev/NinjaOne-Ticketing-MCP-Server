# Railway will supply PORT automatically.
PORT=3000

# Your instance URLs
NINJA_TOKEN_URL=https://beardmangroup.rmmservices.net/oauth/token
NINJA_API_BASE_URL=https://beardmangroup.rmmservices.net/api/v2

# Put these in Railway variables, not in git.
NINJA_CLIENT_ID=replace_me
NINJA_CLIENT_SECRET=replace_me

# Used to protect the MCP endpoint. Pick a long random value.
# Clients call /mcp with: Authorization: Bearer this_value
MCP_SHARED_SECRET=replace_me_with_a_long_random_string

# Optional defaults. Leave blank until you confirm IDs from NinjaOne.
DEFAULT_TICKET_FORM_ID=
DEFAULT_BOARD_ID=
