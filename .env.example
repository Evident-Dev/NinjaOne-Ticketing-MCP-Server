# ── Required ─────────────────────────────────────────────────────────────────
# OAuth 2.0 client credentials from the NinjaOne API app (Admin → Apps → API).
# Use a "Web application" platform app with these grant types enabled:
#   - Authorization Code  (for the one-time browser login)
#   - Client Credentials  (optional fallback; for reads before login)
#   - Refresh Token       (so the login persists)
# And these scopes ticked: Monitoring, Management, offline_access.
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# ── Strongly recommended ─────────────────────────────────────────────────────
# Which NinjaOne region your tenant lives in. One of: us, eu, oc, ca, us2, fed.
# Defaults to "us". For partner/whitelabel instances, leave this and set
# NINJA_BASE_URL instead.
NINJA_REGION=us

# Long random string for admin / shared access. Used by /auth/login (the one-time
# browser sign-in) and as a fallback /mcp/* token for admins or shared service
# accounts. Generate with: openssl rand -hex 32
MCP_SHARED_SECRET=

# ── Per-technician tokens (two options) ─────────────────────────────────────
#
# Option A — DATABASE_URL (recommended for teams)
# Attach a Postgres database in Railway. The plugin auto-injects DATABASE_URL.
# On boot the server:
#   - creates a `technicians` table if missing
#   - syncs NinjaOne /users → DB (adds a row + auto-generates a token for each
#     new TECHNICIAN). Existing rows are left alone.
#   - re-syncs every 15 minutes and on auth-miss.
# View the tokens in Railway → your Postgres service → Data → technicians.
# DATABASE_URL=postgresql://...  (auto-injected by Railway)
#
# Option B — NINJA_TECHNICIANS env var (static allowlist, no DB)
# Used as a fallback if DATABASE_URL is unset. JSON or CSV format.
#   JSON:  [{"email":"alice@x.com","token":"tok_abc","name":"Alice"}, ...]
#   CSV:   alice@x.com:tok_abc:Alice,bob@x.com:tok_xyz:Bob
# NINJA_TECHNICIANS=

# Public URL of this MCP server. Railway sets RAILWAY_PUBLIC_DOMAIN automatically
# after you generate a domain, so you typically don't need to set this. Used to
# build the OAuth callback URL.
# PUBLIC_BASE_URL=https://ninjaone-ticketing-mcp-server-production.up.railway.app

# ── Optional ─────────────────────────────────────────────────────────────────
# Fallback technician email used ONLY when a /mcp request comes in via the
# MCP_SHARED_SECRET (not a per-tech token). For multi-tech setups, leave this
# blank and configure NINJA_TECHNICIANS above instead.
TECHNICIAN_EMAIL=

# Numeric ID of the ticket form to use by default. Find with the
# ninja_list_ticket_forms tool after connecting.
DEFAULT_TICKET_FORM_ID=

# Where to persist the user-context refresh token. Default /data/refresh-token.json
# requires a Railway Volume mounted at /data — without it, the token vanishes on
# every redeploy and you have to re-login.
# USER_TOKEN_PATH=/data/refresh-token.json

# Default board (not currently used by any tool; reserved).
DEFAULT_BOARD_ID=

# Override OAuth scopes. Default is "monitoring management offline_access".
# DO NOT remove offline_access — without it NinjaOne issues no refresh token.
# OAUTH_SCOPE=monitoring management offline_access

# ── Advanced / whitelabel ────────────────────────────────────────────────────
# Custom OAuth callback URL. Defaults to ${PUBLIC_BASE_URL}/auth/callback.
# OAUTH_REDIRECT_URI=https://ninjaone-ticketing-mcp-server-production.up.railway.app/auth/callback

# Partner/whitelabel hostnames: set NINJA_BASE_URL and the token + authorize +
# API URLs are derived from it.
# NINJA_BASE_URL=https://something.rmmservices.net

# Or override individual URLs.
# NINJA_TOKEN_URL=https://something.rmmservices.net/ws/oauth/token
# NINJA_AUTHORIZE_URL=https://something.rmmservices.net/ws/oauth/authorize
# NINJA_API_BASE_URL=https://something.rmmservices.net/api/v2

# Port (Railway injects this automatically).
# PORT=3000
