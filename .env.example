# ── Required ─────────────────────────────────────────────────────────────────
# OAuth 2.0 client credentials from the NinjaOne API app (Admin → Apps → API).
# The app must have grant type "Client Credentials" enabled and API
# permissions granted for the operations you want (Ticketing, Devices, etc).
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# ── Strongly recommended ─────────────────────────────────────────────────────
# Which NinjaOne region your tenant lives in. One of: us, eu, oc, ca, us2, fed.
# Defaults to "us". If you're on a partner/whitelabel instance, leave this and
# set NINJA_BASE_URL instead.
NINJA_REGION=us

# Long random string that protects the /mcp/* endpoints. Claude sends this as
# Authorization: Bearer <secret>. Generate with: openssl rand -hex 32
# If left blank, endpoints are unauthenticated (LOCAL DEV ONLY).
MCP_SHARED_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Your NinjaOne login email. If set, ticket comments are signed with your
# display name and new tickets default to you as the assignee.
TECHNICIAN_EMAIL=

# Numeric ID of the ticket form to use by default. Find with the
# ninja_list_ticket_forms tool after connecting.
DEFAULT_TICKET_FORM_ID=

# Default board (not currently used by any tool; reserved).
DEFAULT_BOARD_ID=

# Override OAuth scopes. Default is "monitoring management" which covers reads
# and writes. Add "control" only if you need remote-control endpoints.
# OAUTH_SCOPE=monitoring management

# ── Advanced / whitelabel ────────────────────────────────────────────────────
# If your tenant is on a non-standard host (e.g. a partner-branded URL),
# set NINJA_BASE_URL and the token/API URLs are derived from it.
# NINJA_BASE_URL=https://something.rmmservices.net

# Or override individual URLs if your instance is even weirder.
# NINJA_TOKEN_URL=https://something.rmmservices.net/ws/oauth/token
# NINJA_API_BASE_URL=https://something.rmmservices.net/api/v2

# Port (Railway injects this automatically).
# PORT=3000
